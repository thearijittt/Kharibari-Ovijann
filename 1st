```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kharibari Ovijan: A Murder Mystery</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Lora:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Lora', serif; background-color: #0f172a; color: #e2e8f0; overflow-x: hidden; }
        h1, h2, h3, .title-font { font-family: 'Cinzel', serif; }
        .bg-overlay { background: linear-gradient(to top, rgba(15, 23, 42, 1) 10%, rgba(15, 23, 42, 0.4) 100%); }
        .fade-in { animation: fadeIn 1s ease-in-out forwards; }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        .clue-found { animation: highlightClue 2s ease-out; }
        @keyframes highlightClue { 0% { color: #facc15; text-shadow: 0 0 10px #facc15; } 100% { color: #e2e8f0; } }
    </style>
</head>
<body class="h-screen w-screen flex flex-col items-center justify-center relative">

    <!-- Background Image container -->
    <div id="bg-container" class="absolute inset-0 z-0 bg-cover bg-center transition-all duration-1000" style="background-image: url('https://images.unsplash.com/photo-1509316785289-025f5b846b35?auto=format&fit=crop&w=1920&q=80');">
        <div class="absolute inset-0 bg-overlay z-10"></div>
    </div>

    <!-- Game Container -->
    <div id="game-app" class="z-20 w-full max-w-4xl p-6 h-full flex flex-col justify-center">
        <!-- Dynamic Content Injected Here via JS -->
    </div>

    <script>
        // --- GAME DATA ---
        const storyData = {
            intro: "The misty morning of Kharibari Bazar was shattered by a gruesome discovery. Local tea-estate manager, Ramen Babu, was found dead near the fish market. As the lead detective, you must explore the surrounding areas, gather clues, and find the killer before the trail goes cold.",
            locations: {
                kharibari: { 
                    id: 'kharibari', name: "Kharibari Bazar", 
                    bg: "https://images.unsplash.com/photo-1519999482648-25049ddd37b1?auto=format&fit=crop&w=1920&q=80", 
                    desc: "The crime scene. It's eerily quiet today. The usual bustle of the market is replaced by police tape.", 
                    clue: { id: 'watch', text: "Broken pocket watch stuck at 2:15 AM. Found near the body." },
                    npc: { name: "Constable Das", text: "Sir, we found strange red mud on his shoes. It doesn't belong to the Bazar area." }
                },
                bhalukgara: { 
                    id: 'bhalukgara', name: "Bhalukgara", 
                    bg: "https://images.unsplash.com/photo-1596704017254-9b121068fb31?auto=format&fit=crop&w=1920&q=80", 
                    desc: "Lush tea gardens surrounding the area. It looks peaceful, but shadows lurk between the leaves.", 
                    clue: { id: 'mud', text: "Distinctive red mud. It matches the mud found on Ramen Babu's shoes." },
                    npc: { name: "Sita (Tea Worker)", text: "Ramen Babu was cruel. He fired Ratan last week without paying his dues. Ratan was furious." }
                },
                batasi: { 
                    id: 'batasi', name: "Batasi", 
                    bg: "https://images.unsplash.com/photo-1515098505761-f09d2d0b1154?auto=format&fit=crop&w=1920&q=80", 
                    desc: "Near the railway tracks. A place where goods (and secrets) are transported quickly.", 
                    clue: null,
                    npc: { name: "Manoj (Rival Merchant)", text: "I hated him, yes. But I was in Siliguri last night! Check my train tickets. Though... I saw him arguing with some shady folks from the border." }
                },
                panitanki: { 
                    id: 'panitanki', name: "Panitanki", 
                    bg: "https://images.unsplash.com/photo-1444080748397-f442aa95c3e5?auto=format&fit=crop&w=1920&q=80", 
                    desc: "The bustling, porous Nepal border. Smugglers often operate in the shadows here.", 
                    clue: { id: 'receipt', text: "A crumpled smuggling receipt showing a massive debt owed by Ramen Babu." },
                    npc: { name: "Bikash (Shady Trader)", text: "Ramen owed us big money. But we didn't kill him. Dead men can't pay debts. Try looking in the Ambari woods." }
                },
                ambari: { 
                    id: 'ambari', name: "Ambari", 
                    bg: "https://images.unsplash.com/photo-1448375240586-882707db888b?auto=format&fit=crop&w=1920&q=80", 
                    desc: "Dense, dark forest outskirts. The trees block out most of the sunlight.", 
                    clue: { id: 'weapon', text: "A bloody tea-pruning knife wrapped in a cloth with Ratan's initials." },
                    npc: null
                }
            },
            suspects: [
                { id: 'ratan', name: "Ratan (Fired Worker)" },
                { id: 'manoj', name: "Manoj (Rival Merchant)" },
                { id: 'bikash', name: "Bikash (Border Smuggler)" }
            ]
        };

        // --- GAME STATE ---
        let state = {
            screen: 'title', // title, map, location, accuse, ending
            currentLocation: null,
            inventory: [],
            talkedTo: [],
            killer: 'ratan' // The actual killer
        };

        // --- DOM ELEMENTS ---
        const app = document.getElementById('game-app');
        const bgContainer = document.getElementById('bg-container');

        // --- RENDER FUNCTIONS ---
        function render() {
            app.innerHTML = '';
            
            if (state.screen === 'title') renderTitle();
            else if (state.screen === 'map') renderMap();
            else if (state.screen === 'location') renderLocation();
            else if (state.screen === 'accuse') renderAccuse();
            else if (state.screen === 'ending') renderEnding();
        }

        function setBackground(url) {
            bgContainer.style.backgroundImage = `url('${url}')`;
        }

        function renderTitle() {
            setBackground('https://images.unsplash.com/photo-1509316785289-025f5b846b35?auto=format&fit=crop&w=1920&q=80');
            app.innerHTML = `
                <div class="text-center fade-in">
                    <h1 class="text-6xl text-red-500 font-bold mb-4 tracking-widest drop-shadow-lg title-font">KHARIBARI OVIJAN</h1>
                    <p class="text-xl text-gray-300 mb-8 italic">A Murder Mystery in the heart of North Bengal</p>
                    <div class="bg-slate-900/80 p-6 rounded-lg border border-slate-700 mb-8 text-left max-w-2xl mx-auto shadow-2xl">
                        <p class="text-lg leading-relaxed">${storyData.intro}</p>
                    </div>
                    <button onclick="changeScreen('map')" class="bg-red-700 hover:bg-red-600 text-white font-bold py-3 px-8 rounded border border-red-500 transition-colors title-font text-xl shadow-[0_0_15px_rgba(220,38,38,0.5)]">
                        BEGIN INVESTIGATION
                    </button>
                </div>
            `;
        }

        function renderMap() {
            setBackground('https://images.unsplash.com/photo-1476820865390-c52aeebb9891?auto=format&fit=crop&w=1920&q=80');
            
            let locationsHtml = Object.values(storyData.locations).map(loc => `
                <button onclick="goToLocation('${loc.id}')" class="group relative bg-slate-800/80 hover:bg-slate-700 border border-slate-600 p-4 rounded-xl text-left transition-all overflow-hidden flex flex-col justify-end h-32 hover:scale-105">
                    <div class="absolute inset-0 bg-cover bg-center opacity-40 group-hover:opacity-60 transition-opacity" style="background-image: url('${loc.bg}')"></div>
                    <span class="relative z-10 text-xl font-bold title-font text-white drop-shadow-md">${loc.name}</span>
                </button>
            `).join('');

            let inventoryHtml = state.inventory.length === 0 ? '<p class="text-gray-500 italic">No clues found yet.</p>' : 
                state.inventory.map(c => `<li class="text-yellow-400 text-sm mb-1 list-disc ml-4">${c}</li>`).join('');

            app.innerHTML = `
                <div class="w-full flex gap-8 fade-in h-[80vh]">
                    <!-- Main Map Area -->
                    <div class="w-2/3 bg-slate-900/90 border border-slate-700 rounded-xl p-6 shadow-2xl flex flex-col">
                        <h2 class="text-3xl text-white mb-6 border-b border-slate-700 pb-2 title-font">Map of the Area</h2>
                        <div class="grid grid-cols-2 gap-4 flex-grow">
                            ${locationsHtml}
                        </div>
                        <div class="mt-6 pt-4 border-t border-slate-700 flex justify-end">
                            <button onclick="changeScreen('accuse')" class="bg-red-900 hover:bg-red-700 text-white px-6 py-2 rounded title-font text-lg border border-red-500">
                                ACCUSE SUSPECT
                            </button>
                        </div>
                    </div>
                    
                    <!-- Sidebar (Notebook) -->
                    <div class="w-1/3 bg-yellow-900/20 border border-yellow-700/50 rounded-xl p-6 backdrop-blur-sm shadow-2xl flex flex-col">
                        <h3 class="text-2xl text-yellow-500 mb-4 title-font border-b border-yellow-700/50 pb-2">Detective's Notebook</h3>
                        
                        <h4 class="text-lg text-white mb-2 font-bold mt-4">Clues Found:</h4>
                        <ul class="flex-grow mb-4 overflow-y-auto pr-2 custom-scrollbar">
                            ${inventoryHtml}
                        </ul>
                    </div>
                </div>
            `;
        }

        function renderLocation() {
            const loc = storyData.locations[state.currentLocation];
            setBackground(loc.bg);

            const hasClue = loc.clue && !state.inventory.includes(loc.clue.text);
            const hasNPC = loc.npc;

            let actionsHtml = '';
            
            if (hasClue) {
                actionsHtml += `<button onclick="findClue('${loc.id}')" class="bg-yellow-600/80 hover:bg-yellow-500 text-white px-6 py-3 rounded text-lg font-bold w-full text-left border border-yellow-400 mb-3 flex justify-between items-center transition-colors">
                    <span>🔍 Investigate the area</span>
                </button>`;
            } else if (loc.clue) {
                actionsHtml += `<div class="bg-slate-800/80 text-gray-400 px-6 py-3 rounded text-lg w-full text-left border border-slate-600 mb-3 italic">
                    Area already investigated.
                </div>`;
            }

            if (hasNPC) {
                const talkedTo = state.talkedTo.includes(loc.npc.name);
                actionsHtml += `<button onclick="talkToNPC('${loc.id}')" class="bg-blue-600/80 hover:bg-blue-500 text-white px-6 py-3 rounded text-lg font-bold w-full text-left border border-blue-400 mb-3 flex justify-between items-center transition-colors">
                    <span>🗣️ Talk to ${loc.npc.name}</span>
                </button>`;
            }

            app.innerHTML = `
                <div class="w-full max-w-3xl mx-auto bg-slate-900/90 border border-slate-700 rounded-xl p-8 shadow-2xl fade-in relative">
                    <button onclick="changeScreen('map')" class="absolute top-4 right-4 text-gray-400 hover:text-white transition-colors">
                        ✖ Return to Map
                    </button>
                    <h2 class="text-4xl text-white mb-2 title-font">${loc.name}</h2>
                    <p class="text-xl text-gray-300 mb-8 italic">${loc.desc}</p>
                    
                    <div id="action-feedback" class="mb-6 h-20 text-lg"></div>

                    <div class="mt-8 pt-6 border-t border-slate-700">
                        ${actionsHtml}
                    </div>
                </div>
            `;
        }

        function renderAccuse() {
            setBackground('https://images.unsplash.com/photo-1509316785289-025f5b846b35?auto=format&fit=crop&w=1920&q=80');
            
            let suspectsHtml = storyData.suspects.map(s => `
                <button onclick="makeAccusation('${s.id}')" class="bg-slate-800 hover:bg-red-900 border border-slate-600 hover:border-red-500 p-4 rounded-xl text-left transition-colors text-xl font-bold title-font w-full mb-4">
                    Accuse ${s.name}
                </button>
            `).join('');

            app.innerHTML = `
                <div class="w-full max-w-2xl mx-auto bg-slate-900/95 border border-red-900 rounded-xl p-8 shadow-2xl fade-in">
                    <button onclick="changeScreen('map')" class="text-gray-400 hover:text-white mb-6 block transition-colors">
                        ← Back to Investigation
                    </button>
                    <h2 class="text-4xl text-red-500 mb-6 title-font border-b border-red-900 pb-2">Gather the Suspects</h2>
                    <p class="text-xl text-gray-300 mb-8">You have gathered all the clues from Kharibari, Batasi, Panitanki, and Bhalukgara. It is time to make your final decision. Who killed Ramen Babu?</p>
                    
                    <div>
                        ${suspectsHtml}
                    </div>
                </div>
            `;
        }

        function renderEnding() {
            const isCorrect = state.accused === state.killer;
            setBackground(isCorrect ? 'https://images.unsplash.com/photo-1542281286-9e0a16bb7366?auto=format&fit=crop&w=1920&q=80' : 'https://images.unsplash.com/photo-1503389152951-9f343605f61e?auto=format&fit=crop&w=1920&q=80');
            
            const title = isCorrect ? "CASE SOLVED" : "CASE FAILED";
            const titleColor = isCorrect ? "text-green-500" : "text-red-600";
            
            let message = "";
            if (isCorrect) {
                message = `You correctly deduced that Ratan was the killer. The red mud from Bhalukgara and the bloody pruning knife in Ambari confirmed it. Driven by desperation after being fired without pay, Ratan ambushed Ramen Babu in the Kharibari Bazar early in the morning. Justice has been served in North Bengal.`;
            } else {
                message = `You accused the wrong person. While they had their motives, the true killer slipped away into the tea gardens of Bhalukgara. The clues (the red mud, the pruning knife) pointed elsewhere. Ramen Babu's case remains a dark stain on the history of Kharibari.`;
            }

            app.innerHTML = `
                <div class="text-center bg-slate-900/90 border border-slate-700 p-10 rounded-xl shadow-2xl max-w-2xl mx-auto fade-in">
                    <h1 class="text-6xl ${titleColor} font-bold mb-6 title-font drop-shadow-lg">${title}</h1>
                    <p class="text-xl text-gray-200 mb-8 leading-relaxed">${message}</p>
                    <button onclick="resetGame()" class="bg-transparent hover:bg-white text-white font-semibold hover:text-black py-2 px-6 border border-white hover:border-transparent rounded transition-colors text-lg title-font">
                        PLAY AGAIN
                    </button>
                </div>
            `;
        }

        // --- GAME LOGIC ---
        function changeScreen(newScreen) {
            state.screen = newScreen;
            render();
        }

        function goToLocation(locId) {
            state.currentLocation = locId;
            changeScreen('location');
        }

        function findClue(locId) {
            const loc = storyData.locations[locId];
            if (loc.clue && !state.inventory.includes(loc.clue.text)) {
                state.inventory.push(loc.clue.text);
                const feedbackDiv = document.getElementById('action-feedback');
                feedbackDiv.innerHTML = `<div class="bg-yellow-900/40 border border-yellow-600 p-4 rounded text-yellow-300 shadow-inner fade-in">
                    <strong>Clue Found:</strong> ${loc.clue.text}
                </div>`;
                
                // Re-render location buttons after a short delay to update button state
                setTimeout(renderLocation, 2500);
            }
        }

        function talkToNPC(locId) {
            const loc = storyData.locations[locId];
            if (loc.npc) {
                if (!state.talkedTo.includes(loc.npc.name)) {
                    state.talkedTo.push(loc.npc.name);
                }
                const feedbackDiv = document.getElementById('action-feedback');
                feedbackDiv.innerHTML = `<div class="bg-blue-900/40 border border-blue-600 p-4 rounded text-blue-200 shadow-inner fade-in italic">
                    "${loc.npc.text}" - <strong>${loc.npc.name}</strong>
                </div>`;
            }
        }

        function makeAccusation(suspectId) {
            state.accused = suspectId;
            changeScreen('ending');
        }

        function resetGame() {
            state = {
                screen: 'title',
                currentLocation: null,
                inventory: [],
                talkedTo: [],
                killer: 'ratan'
            };
            render();
        }

        // Initialize game
        render();

    </script>
</body>
</html>

```
